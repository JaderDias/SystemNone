{
  "name": "system-none-keynote",
  "version": "1.0.0",
  "description": "Keynote-style explainer video for SystemNone, rendered from HTML",
  "scripts": {
    "check": "node check-audio.js && node check.js",
    "preview": "node render.js serve",
    "music": "node music.js",
    "video": "node render.js video 60 10",
    "mux": "node render.js mux",
    "readme-image": "node render.js still 74 how-it-works.png 1280",
    "build": "npm run check",
    "export:mp4": "node music.js && node render.js video 60 10 && node render.js mux && node render.js web && node render.js poster"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "inter-ui": "^4.1.1",
    "puppeteer-core": "^25.12.0"
  },
  "private": true
}
